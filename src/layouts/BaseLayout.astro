---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface BaseLayoutProps {
	title: string;
	description: string;
}

type Props = BaseLayoutProps;

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=avatar-1" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=avatar-1" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-avatar.png?v=avatar-1" />
		<link
			rel="apple-touch-icon"
			sizes="180x180"
			href="/apple-touch-icon.png?v=avatar-1"
		/>
		<link rel="shortcut icon" href="/favicon.ico?v=avatar-1" />
		<title>{title}</title>
	</head>
	<body>
		<SiteHeader />
		<slot />
		<SiteFooter />
		<script>
			import { inject } from "@vercel/analytics";

			inject();
		</script>
	</body>
</html>
