---
import { SITE_CONFIG } from "../data/site";
import SocialIcon from "./SocialIcon.astro";

const pathname = Astro.url.pathname;

const isCurrentRoute = (href: string) => {
	const route = href.split("#")[0];

	return route !== "/" && (pathname === route || pathname.startsWith(`${route}/`));
};
---

<header class="site-header" id="top" data-site-header>
	<div class="site-header__inner shell">
		<a
			class="site-header__brand"
			href="/"
			aria-label="Brad Traversy, home"
			aria-current={pathname === "/" ? "page" : undefined}
		>
			Brad Traversy
		</a>

		<button
			class="site-header__menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-navigation"
			aria-label="Open menu"
			data-menu-toggle
		>
			<span aria-hidden="true"></span>
			<span aria-hidden="true"></span>
		</button>

		<div class="site-header__desktop" id="site-navigation" data-menu-panel>
			<nav aria-label="Primary navigation">
				<ul>
					{
						SITE_CONFIG.navigation.map((item) => (
							<li>
								<a
									href={item.href}
									target={item.external ? "_blank" : undefined}
									rel={item.external ? "noreferrer" : undefined}
									aria-current={
										!item.external && isCurrentRoute(item.href) ? "page" : undefined
									}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>

			<ul class="site-header__socials" aria-label="Social links">
				{
					SITE_CONFIG.socialLinks.map((social) => (
						<li>
							<a href={social.url} target="_blank" rel="noreferrer" aria-label={social.label}>
								<SocialIcon icon={social.icon} />
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</header>

<script>
	const header = document.querySelector("[data-site-header]");

	if (header instanceof HTMLElement) {
		const toggle = header.querySelector("[data-menu-toggle]");
		const panel = header.querySelector("[data-menu-panel]");
		const desktopQuery = window.matchMedia("(min-width: 47.5625rem)");

		if (toggle instanceof HTMLButtonElement && panel instanceof HTMLElement) {
			const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
			const setOpen = (open: boolean) => {
				header.classList.toggle("is-menu-open", open);
				toggle.setAttribute("aria-expanded", String(open));
				toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
			};

			header.classList.add("has-menu-js");
			setOpen(false);

			toggle.addEventListener("click", () => setOpen(!isOpen()));

			toggle.addEventListener("keydown", (event) => {
				if (event.key === "Enter" || event.key === " ") {
					event.preventDefault();
					setOpen(!isOpen());
				}
			});

			panel.addEventListener("click", (event) => {
				const link = event.target instanceof Element ? event.target.closest("a") : null;

				if (link && !desktopQuery.matches) {
					setOpen(false);
				}
			});

			document.addEventListener("click", (event) => {
				if (isOpen() && event.target instanceof Node && !header.contains(event.target)) {
					setOpen(false);
				}
			});

			document.addEventListener("keydown", (event) => {
				if (event.key === "Escape" && isOpen()) {
					setOpen(false);
					toggle.focus();
				}
			});

			desktopQuery.addEventListener("change", (event) => {
				if (event.matches) {
					setOpen(false);
				}
			});
		}
	}
</script>

<style>
	.site-header {
		border-bottom: 1px solid var(--color-line);
	}

	.site-header__inner {
		display: flex;
		min-height: 5.5rem;
		align-items: center;
		justify-content: space-between;
	}

	.site-header__brand {
		color: var(--color-bone);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		line-height: 1;
		text-decoration: none;
		text-transform: uppercase;
	}

	.site-header__desktop,
	.site-header nav ul,
	.site-header__socials {
		display: flex;
		align-items: center;
	}

	.site-header nav ul,
	.site-header__socials {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.site-header nav ul {
		gap: 1.75rem;
	}

	.site-header nav a {
		color: var(--color-muted);
		font-size: 0.8125rem;
		font-weight: 500;
		text-decoration: none;
	}

	.site-header nav a:hover,
	.site-header nav a[aria-current="page"] {
		color: var(--color-bone);
	}

	.site-header__socials {
		gap: 1.25rem;
		margin-left: 1.75rem;
		padding-left: 1.75rem;
		border-left: 1px solid var(--color-line);
	}

	.site-header__socials a {
		display: block;
		width: 1rem;
		height: 1rem;
		color: var(--color-muted);
	}

	.site-header__socials a:hover {
		color: var(--color-gold-soft);
	}

	.site-header__menu-toggle {
		display: none;
		width: 2.75rem;
		height: 2.75rem;
		padding: 0.75rem;
		border: 1px solid var(--color-line);
		background: transparent;
		color: var(--color-bone);
		cursor: pointer;
	}

	.site-header__menu-toggle span {
		display: block;
		width: 100%;
		height: 1px;
		background: currentColor;
		transition: transform 160ms ease;
	}

	.site-header__menu-toggle span + span {
		margin-top: 0.4rem;
	}

	@media (max-width: 47.5rem) {
		.site-header__inner {
			min-height: 4.5rem;
			flex-wrap: wrap;
		}

		.site-header__desktop {
			width: 100%;
			align-items: stretch;
			flex-direction: column;
			padding-block: 0.75rem 1.5rem;
			border-top: 1px solid var(--color-line);
		}

		.site-header.has-menu-js .site-header__menu-toggle {
			display: block;
		}

		.site-header.has-menu-js .site-header__desktop {
			display: none;
		}

		.site-header.has-menu-js.is-menu-open .site-header__desktop {
			display: flex;
		}

		.site-header nav ul {
			align-items: stretch;
			flex-direction: column;
			gap: 0;
		}

		.site-header nav a {
			display: block;
			padding-block: 0.7rem;
			font-size: 0.9375rem;
		}

		.site-header__socials {
			gap: 1.5rem;
			margin: 0.5rem 0 0;
			padding: 1.25rem 0 0;
			border-top: 1px solid var(--color-line);
			border-left: 0;
		}

		.site-header__socials a {
			width: 1.125rem;
			height: 1.125rem;
		}

		.site-header.is-menu-open .site-header__menu-toggle span:first-child {
			transform: translateY(0.225rem) rotate(45deg);
		}

		.site-header.is-menu-open .site-header__menu-toggle span:last-child {
			transform: translateY(-0.225rem) rotate(-45deg);
		}
	}
</style>
