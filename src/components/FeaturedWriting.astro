---
import { HOMEPAGE_ARTICLES } from "../data/home";

const featuredArticle = HOMEPAGE_ARTICLES.find((article) => article.featured);
const supportingArticles = HOMEPAGE_ARTICLES.filter((article) => !article.featured);

if (!featuredArticle) {
	throw new Error("The homepage requires one featured article.");
}
---

<section class="writing section" id="writing" aria-labelledby="writing-title">
	<div class="writing__grid shell">
		<article class="writing__featured">
			<p class="writing__meta">Featured writing</p>
			<h2 id="writing-title">{featuredArticle.title}</h2>
			{featuredArticle.summary && <p>{featuredArticle.summary}</p>}
			<a
				class="writing__text-link"
				href={featuredArticle.url}
				target="_blank"
				rel="noreferrer"
			>
				Read the article <span aria-hidden="true">→</span>
			</a>
		</article>

		<div class="writing__list" aria-label="More recent writing">
			{
				supportingArticles.map((article) => (
					<a
						class="writing__row"
						href={article.url}
						target="_blank"
						rel="noreferrer"
						aria-label={`Read ${article.title}`}
					>
						<div>
							<h3>{article.title}</h3>
							<span>
								{article.topic} · {article.dateLabel}
							</span>
						</div>
						<span class="writing__arrow" aria-hidden="true">→</span>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.section {
		padding-block: 8.25rem;
	}

	.writing {
		border-top: 1px solid var(--color-line);
		background: var(--color-black);
	}

	.writing__grid {
		display: grid;
		grid-template-columns: 1.15fr 0.85fr;
		gap: 5.625rem;
	}

	.writing__featured {
		padding-right: 3.125rem;
		border-right: 1px solid var(--color-line);
	}

	.writing__meta {
		margin: 0 0 1.5rem;
		color: var(--color-gold);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h2 {
		max-width: 47.5rem;
		margin: 0 0 1.75rem;
		font-size: clamp(2.625rem, 5vw, 4.625rem);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	.writing__featured > p:not(.writing__meta) {
		max-width: 38.75rem;
		margin: 0 0 2rem;
		color: var(--color-muted);
	}

	.writing__text-link {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		color: var(--color-gold-soft);
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
	}

	.writing__list {
		display: flex;
		flex-direction: column;
		justify-content: center;
	}

	.writing__row {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 1.875rem;
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--color-line);
		text-decoration: none;
	}

	.writing__row:first-child {
		border-top: 1px solid var(--color-line);
	}

	h3 {
		margin: 0 0 0.4375rem;
		font-size: 1.3125rem;
		font-weight: 500;
		line-height: 1.35;
		transition: color 180ms ease;
	}

	.writing__row span {
		color: var(--color-muted);
		font-size: 0.75rem;
	}

	.writing__row .writing__arrow {
		align-self: center;
		color: var(--color-gold);
		font-size: 1.25rem;
		transition: transform 180ms ease;
	}

	.writing__row:hover h3 {
		color: var(--color-gold-soft);
	}

	.writing__row:hover .writing__arrow {
		transform: translateX(0.1875rem);
	}

	@media (max-width: 56.25rem) {
		.writing__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.writing__featured {
			padding: 0 0 3.75rem;
			border-right: 0;
			border-bottom: 1px solid var(--color-line);
		}
	}

	@media (max-width: 40rem) {
		.section {
			padding-block: 5.5rem;
		}
	}
</style>
