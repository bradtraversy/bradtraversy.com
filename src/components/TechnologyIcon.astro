---
import {
	siAstro,
	siClaudecode,
	siDrizzle,
	siExpress,
	siHono,
	siMarkdown,
	siNeon,
	siNextdotjs,
	siPostgresql,
	siPrisma,
	siReact,
	siRust,
	siStripe,
	siTailwindcss,
	siTypescript,
	siVercel,
	type SimpleIcon,
} from "simple-icons";

interface Props {
	technology: string;
}

const { technology } = Astro.props;

const TECHNOLOGY_ICONS: Record<string, SimpleIcon> = {
	Astro: siAstro,
	"Claude Code": siClaudecode,
	Drizzle: siDrizzle,
	Express: siExpress,
	Hono: siHono,
	Markdown: siMarkdown,
	Neon: siNeon,
	"Next.js": siNextdotjs,
	Postgres: siPostgresql,
	PostgreSQL: siPostgresql,
	Prisma: siPrisma,
	React: siReact,
	Rust: siRust,
	Stripe: siStripe,
	"Tailwind CSS": siTailwindcss,
	TypeScript: siTypescript,
	Vercel: siVercel,
};

const icon = TECHNOLOGY_ICONS[technology];
const fallbackPath =
	"M8.7 16.6 4.1 12l4.6-4.6L7.3 6l-6 6 6 6 1.4-1.4Zm6.6 0 4.6-4.6-4.6-4.6L16.7 6l6 6-6 6-1.4-1.4Z";
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
	<path d={icon?.path ?? fallbackPath}></path>
</svg>

<style>
	svg {
		display: block;
		width: 100%;
		height: 100%;
		fill: currentColor;
	}
</style>
