---
import type { ProjectEntry } from "../lib/projects";
import ProjectBadges from "./ProjectBadges.astro";

interface Props {
	project: ProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
---

<section
	class="project-detail-overview shell"
	id="details"
	aria-labelledby="project-details-title"
>
	<div class="project-detail-overview__intro">
		<div>
			<p class="project-detail-overview__eyebrow">{data.type}</p>
			<h2 id="project-details-title">{data.tagline}</h2>
		</div>
		<div>
			<p class="project-detail-overview__summary">{data.summary}</p>
			<ProjectBadges project={project} align="start" />
		</div>
	</div>

	<div class="project-detail-overview__grid">
		<div>
			<p class="project-detail-overview__label">Built with</p>
			<ul
				class="project-detail-overview__stack"
				aria-label={`${data.title} technology stack`}
			>
				{data.stack.map((technology) => <li>{technology}</li>)}
			</ul>
		</div>

		<div>
			<p class="project-detail-overview__label">Explore</p>
			<div class="project-detail-overview__actions">
				<a
					class="project-detail-overview__button project-detail-overview__button--primary"
					href={data.liveUrl}
					target="_blank"
					rel="noreferrer"
				>
					Open {data.title} <span aria-hidden="true">↗</span>
				</a>
				<a
					class="project-detail-overview__button"
					href={data.devlogUrl}
					target="_blank"
					rel="noreferrer"
				>
					More project info <span aria-hidden="true">→</span>
				</a>
				{
					data.repoUrl && (
						<a
							class="project-detail-overview__button"
							href={data.repoUrl}
							target="_blank"
							rel="noreferrer"
						>
							{data.repoLabel ?? "View source"} <span aria-hidden="true">↗</span>
						</a>
					)
				}
			</div>
		</div>
	</div>
</section>

<style>
	.project-detail-overview {
		padding-block: 7rem;
		border-top: 1px solid var(--color-line);
	}

	.project-detail-overview__intro {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(21.25rem, 0.65fr);
		align-items: end;
		gap: 5rem;
		margin-bottom: 5rem;
	}

	.project-detail-overview__eyebrow,
	.project-detail-overview__label {
		margin: 0 0 1.5rem;
		color: var(--color-gold);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	h2 {
		max-width: 55rem;
		margin: 0;
		font-size: clamp(2.75rem, 5.8vw, 5.25rem);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 0.98;
	}

	.project-detail-overview__summary {
		margin: 0 0 1.5rem;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.7;
	}

	.project-detail-overview__grid {
		display: grid;
		grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
		gap: 5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--color-line);
	}

	.project-detail-overview__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-detail-overview__stack li {
		padding: 0.5rem 0.6875rem;
		border: 1px solid var(--color-line);
		color: var(--color-muted);
		font-size: 0.6875rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.project-detail-overview__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.project-detail-overview__button {
		display: inline-flex;
		min-height: 3rem;
		align-items: center;
		justify-content: center;
		gap: 0.5625rem;
		padding-inline: 1.25rem;
		border: 1px solid var(--color-line);
		font-size: 0.8125rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.project-detail-overview__button--primary {
		border-color: var(--color-gold);
		background: var(--color-gold);
		color: var(--color-black);
	}

	.project-detail-overview__button--primary:hover,
	.project-detail-overview__button--primary:focus-visible {
		border-color: var(--color-gold-soft);
		background: var(--color-gold-soft);
	}

	.project-detail-overview__button:not(.project-detail-overview__button--primary):hover,
	.project-detail-overview__button:not(.project-detail-overview__button--primary):focus-visible {
		border-color: var(--color-bone);
	}

	@media (max-width: 65.625rem) {
		.project-detail-overview__intro,
		.project-detail-overview__grid {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}
	}

	@media (max-width: 47.5rem) {
		.project-detail-overview {
			padding-block: 5.125rem;
		}

		.project-detail-overview__intro {
			margin-bottom: 3.75rem;
		}
	}
</style>
