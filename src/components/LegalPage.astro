---
interface Props {
	title: string;
	intro: string;
	updated: string;
}

const { title, intro, updated } = Astro.props;
---

<main class="legal-page">
	<header class="legal-hero shell">
		<p class="legal-eyebrow">Slot Recovery by TravxLabs</p>
		<h1>{title}</h1>
		<p class="legal-intro">{intro}</p>
		<p class="legal-updated">Last updated: {updated}</p>
	</header>

	<article class="legal-content shell">
		<slot />
	</article>
</main>

<style>
	.legal-page {
		padding: clamp(4rem, 9vw, 7rem) 0 clamp(5rem, 10vw, 8rem);
	}

	.legal-hero {
		padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
		border-bottom: 1px solid var(--color-line);
	}

	.legal-eyebrow {
		margin: 0 0 1rem;
		color: var(--color-gold);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	h1 {
		max-width: 11ch;
		margin: 0;
		font-size: clamp(3rem, 8vw, 6.5rem);
		font-weight: 600;
		letter-spacing: -0.055em;
		line-height: 0.96;
	}

	.legal-intro {
		max-width: 48rem;
		margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
		color: var(--color-muted);
		font-size: clamp(1.05rem, 2vw, 1.25rem);
		line-height: 1.75;
	}

	.legal-updated {
		margin: 1.5rem 0 0;
		color: var(--color-bone);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.legal-content {
		display: grid;
		gap: 2.75rem;
		max-width: 54rem;
		padding-top: clamp(3rem, 7vw, 5rem);
	}

	.legal-content :global(section) {
		display: grid;
		gap: 1rem;
	}

	.legal-content :global(h2) {
		margin: 0;
		color: var(--color-gold-soft);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}

	.legal-content :global(p),
	.legal-content :global(ul) {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.8;
	}

	.legal-content :global(ul) {
		display: grid;
		gap: 0.7rem;
		padding-left: 1.25rem;
	}

	.legal-content :global(strong) {
		color: var(--color-bone);
		font-weight: 600;
	}

	.legal-content :global(a) {
		color: var(--color-gold-soft);
		text-underline-offset: 0.22em;
	}

	.legal-content :global(a:hover) {
		color: var(--color-gold);
	}
</style>
