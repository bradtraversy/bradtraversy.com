---
import { Image } from "astro:assets";
import type { CaseStudyProjectEntry } from "../lib/projects";

interface Props {
	project: CaseStudyProjectEntry;
}

const { project } = Astro.props;
const { data } = project;
const { caseStudy } = data;
---

<section class="project-detail-hero shell" aria-labelledby="project-title">
	<a class="project-detail-hero__back" href="/projects">
		<span aria-hidden="true">←</span> All projects
	</a>

	<div class="project-detail-hero__heading">
		<div>
			<p class="project-detail-hero__eyebrow">Selected project / {data.status}</p>
			<h1 id="project-title">{caseStudy.title.base}<em>{caseStudy.title.accent}</em></h1>
		</div>

		<div class="project-detail-hero__copy">
			<p>{caseStudy.description}</p>
			<div class="project-detail-hero__actions">
				<a
					class="project-detail-hero__button project-detail-hero__button--primary"
					href={data.liveUrl}
					target="_blank"
					rel="noreferrer"
				>
					Visit {data.title} <span aria-hidden="true">↗</span>
				</a>
				<a class="project-detail-hero__button" href="#story">Explore the project</a>
			</div>
		</div>
	</div>
</section>

<section
	class="project-detail-stage shell"
	aria-label={`${data.title} product preview`}
>
	<div class="project-detail-stage__visual">
		<Image
			src={data.hero.src}
			alt={data.hero.alt}
			widths={[720, 1080, 1440]}
			sizes="(max-width: 40rem) calc(100vw - 3rem), (max-width: 87.5rem) calc(100vw - 7.5rem), 82.5rem"
		/>
	</div>

	<dl class="project-detail-stage__meta">
		<div>
			<dt>Role</dt>
			<dd>{data.role}</dd>
		</div>
		<div>
			<dt>Product</dt>
			<dd>{caseStudy.productLabel}</dd>
		</div>
		<div>
			<dt>Stack</dt>
			<dd>{data.stack.join(", ")}</dd>
		</div>
	</dl>
</section>

<style>
	.project-detail-hero {
		padding-block: 4.5rem 4rem;
	}

	.project-detail-hero__back {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		margin-bottom: 3.625rem;
		color: var(--color-muted);
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: none;
	}

	.project-detail-hero__back span {
		color: var(--color-gold);
		transition: transform 180ms ease;
	}

	.project-detail-hero__back:hover,
	.project-detail-hero__back:focus-visible {
		color: var(--color-bone);
	}

	.project-detail-hero__back:hover span,
	.project-detail-hero__back:focus-visible span {
		transform: translateX(-0.25rem);
	}

	.project-detail-hero__heading {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(21.25rem, 0.55fr);
		align-items: end;
		gap: 4.75rem;
	}

	.project-detail-hero__eyebrow {
		margin: 0 0 1.5rem;
		color: var(--color-gold);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	h1 {
		max-width: none;
		margin: 0;
		font-size: clamp(4.5rem, 9.2vw, 8.25rem);
		font-weight: 500;
		letter-spacing: -0.066em;
		line-height: 0.94;
	}

	h1 em {
		color: var(--color-gold-soft);
		font-style: normal;
		font-weight: inherit;
	}

	.project-detail-hero__copy {
		padding-bottom: 0.5rem;
	}

	.project-detail-hero__copy > p {
		margin: 0 0 1.875rem;
		color: var(--color-muted);
		font-size: 1.125rem;
		line-height: 1.65;
	}

	.project-detail-hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.project-detail-hero__button {
		display: inline-flex;
		min-height: 3rem;
		align-items: center;
		justify-content: center;
		gap: 0.5625rem;
		padding-inline: 1.25rem;
		border: 1px solid var(--color-line);
		font-size: 0.8125rem;
		font-weight: 700;
		text-decoration: none;
		transition:
			background 180ms ease,
			border-color 180ms ease,
			color 180ms ease;
	}

	.project-detail-hero__button--primary {
		border-color: var(--color-gold);
		background: var(--color-gold);
		color: var(--color-black);
	}

	.project-detail-hero__button--primary:hover,
	.project-detail-hero__button--primary:focus-visible {
		border-color: var(--color-gold-soft);
		background: var(--color-gold-soft);
	}

	.project-detail-hero__button:not(.project-detail-hero__button--primary):hover,
	.project-detail-hero__button:not(.project-detail-hero__button--primary):focus-visible {
		border-color: var(--color-bone);
	}

	.project-detail-stage {
		padding-bottom: 5.75rem;
	}

	.project-detail-stage__visual {
		position: relative;
		overflow: hidden;
		aspect-ratio: 16 / 8.9;
		border: 1px solid var(--color-line);
		background: #efece4;
	}

	.project-detail-stage__visual::after {
		position: absolute;
		inset: 0;
		border: 1px solid rgba(255, 255, 255, 0.08);
		content: "";
		pointer-events: none;
	}

	.project-detail-stage__visual :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	.project-detail-stage__meta {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		margin: 0;
		border-right: 1px solid var(--color-line);
		border-bottom: 1px solid var(--color-line);
		border-left: 1px solid var(--color-line);
	}

	.project-detail-stage__meta div {
		min-width: 0;
		padding: 1.375rem 1.5rem;
	}

	.project-detail-stage__meta div + div {
		border-left: 1px solid var(--color-line);
	}

	.project-detail-stage__meta dt {
		margin-bottom: 0.3125rem;
		color: var(--color-gold);
		font-size: 0.625rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.project-detail-stage__meta dd {
		margin: 0;
		font-size: 0.8125rem;
	}

	@media (max-width: 65.625rem) {
		.project-detail-hero__heading {
			grid-template-columns: 1fr;
			gap: 2.375rem;
		}

		.project-detail-hero__copy {
			max-width: 45rem;
		}
	}

	@media (max-width: 47.5rem) {
		.project-detail-hero {
			padding-block: 3rem 2.75rem;
		}

		.project-detail-hero__back {
			margin-bottom: 2.5rem;
		}

		h1 {
			font-size: clamp(3.875rem, 19vw, 5.625rem);
		}

		.project-detail-stage {
			padding-bottom: 4.375rem;
		}

		.project-detail-stage__visual {
			aspect-ratio: 4 / 3;
		}

		.project-detail-stage__meta {
			grid-template-columns: 1fr;
		}

		.project-detail-stage__meta div + div {
			border-top: 1px solid var(--color-line);
			border-left: 0;
		}
	}
</style>
