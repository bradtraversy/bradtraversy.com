---
import { Image } from "astro:assets";
import { getHomepageProjects, getProjectPrimaryHref } from "../lib/projects";
import ProjectBadges from "./ProjectBadges.astro";

const projects = (await getHomepageProjects()).slice(0, 4);
---

<section class="projects section" id="projects" aria-labelledby="projects-title">
	<div class="shell">
		<div class="section__head">
			<div>
				<p class="section__kicker">Independent software</p>
				<h2 id="projects-title">Recent <em>Projects</em></h2>
			</div>
			<p class="section__note">
				Developer tools, experiments, open-source projects, and products I build outside
				of the main education platforms.
			</p>
		</div>

		<div class="projects__gallery">
			{
				projects.map((project) => {
					const { data } = project;
					const primaryHref = getProjectPrimaryHref(project);

					return (
						<article class="project">
							<a
								class="project__media"
								href={primaryHref}
								data-image-fit={data.hero.fit}
								aria-label={`View ${data.title} project: ${data.summary}`}
							>
								<Image
									src={data.hero.src}
									alt={data.hero.alt}
									widths={[480, 720, 960]}
									sizes="(max-width: 640px) calc(100vw - 3rem), (max-width: 1440px) calc((100vw - 8rem) / 2), 39rem"
								/>
							</a>
							<div class="project__copy">
								<div>
									<span class="project__type">{data.type}</span>
									<h3>{data.title}</h3>
									<div class="project__badges">
										<ProjectBadges project={project} align="start" />
									</div>
								</div>
								<span class="project__arrow" aria-hidden="true">→</span>
								<p>{data.summary}</p>
								<ul class="project__stack" aria-label={`${data.title} technology stack`}>
									{data.stack.map((technology) => <li>{technology}</li>)}
								</ul>
								<div class="project__actions">
									<a href={data.liveUrl} target="_blank" rel="noreferrer">
										Visit site <span aria-hidden="true">↗</span>
									</a>
									<a href={primaryHref}>
										View project <span aria-hidden="true">→</span>
									</a>
									<a href={data.devlogUrl} target="_blank" rel="noreferrer">
										More info <span aria-hidden="true">→</span>
									</a>
									{
										data.repoUrl && (
											<a href={data.repoUrl} target="_blank" rel="noreferrer">
												{data.repoLabel ?? "Source"} <span aria-hidden="true">↗</span>
											</a>
										)
									}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
		<a class="projects__archive-link" href="/projects">
			View all projects
			<span aria-hidden="true">→</span>
		</a>
	</div>
</section>

<style>
	.section {
		padding-block: 8.25rem;
	}

	.projects {
		background: linear-gradient(145deg, rgba(23, 17, 10, 0.96), rgba(13, 12, 10, 0.98));
	}

	.section__head {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		align-items: end;
		gap: 5rem;
		margin-bottom: 4.375rem;
	}

	.section__kicker {
		margin: 0 0 1.5rem;
		color: var(--color-gold);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	h2 {
		max-width: 45rem;
		margin: 0;
		font-size: clamp(2.625rem, 5vw, 4.625rem);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	h2 em {
		color: var(--color-gold-soft);
		font-style: normal;
		font-weight: inherit;
	}

	.section__note {
		max-width: 31.875rem;
		justify-self: end;
		margin: 0 0 0.25rem;
		color: var(--color-muted);
	}

	.projects__gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4.75rem 2.625rem;
	}

	.project {
		display: block;
	}

	.project__media {
		display: block;
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border: 1px solid var(--color-line);
		background: linear-gradient(145deg, rgba(11, 10, 8, 0.98), rgba(18, 13, 8, 0.96));
	}

	.project__media::after {
		position: absolute;
		inset: 0;
		border: 1px solid transparent;
		content: "";
		pointer-events: none;
		transition: border-color 180ms ease;
	}

	.project__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transition: transform 260ms ease;
	}

	.project__media[data-image-fit="contain"] :global(img) {
		object-fit: contain;
	}

	.project__copy {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 1.5rem;
		padding-top: 1.375rem;
	}

	.project__type {
		color: var(--color-muted);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h3 {
		margin: 0.375rem 0 0;
		font-size: clamp(1.5rem, 2vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		transition: color 180ms ease;
	}

	.project__badges {
		margin-top: 0.75rem;
	}

	.project__copy p {
		max-width: 32.5rem;
		margin: -0.75rem 0 0;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.project__stack,
	.project__actions {
		grid-column: 1 / -1;
	}

	.project__stack {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4375rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project__stack li {
		padding: 0.25rem 0.5rem;
		border: 1px solid var(--color-line);
		color: var(--color-muted);
		font-size: 0.625rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	.project__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 1.375rem;
		font-size: 0.75rem;
		font-weight: 700;
	}

	.project__actions a {
		text-decoration: none;
	}

	.project__actions a:hover,
	.project__actions a:focus-visible {
		color: var(--color-gold-soft);
	}

	.project__arrow {
		color: var(--color-gold);
		font-size: 1.25rem;
		transition: transform 180ms ease;
	}

	.project:hover .project__media::after {
		border-color: var(--color-gold);
	}

	.project:hover .project__media :global(img) {
		transform: scale(1.015);
	}

	.project:hover h3 {
		color: var(--color-gold-soft);
	}

	.project:hover .project__arrow {
		transform: translate(0.1875rem, -0.1875rem);
	}

	.projects__archive-link {
		display: inline-flex;
		align-items: center;
		gap: 0.625rem;
		margin-top: 4.75rem;
		color: var(--color-gold-soft);
		font-size: 0.875rem;
		font-weight: 700;
		text-decoration: none;
	}

	.projects__archive-link span {
		transition: transform 180ms ease;
	}

	.projects__archive-link:hover span,
	.projects__archive-link:focus-visible span {
		transform: translateX(0.25rem);
	}

	@media (max-width: 56.25rem) {
		.section__head {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.section__note {
			justify-self: start;
		}
	}

	@media (max-width: 40rem) {
		.section {
			padding-block: 5.5rem;
		}

		.section__head {
			margin-bottom: 3rem;
		}

		.projects__gallery {
			grid-template-columns: 1fr;
			gap: 3.75rem;
		}

		.project__copy {
			grid-template-columns: 1fr 1.5rem;
		}

		.project__copy p {
			grid-column: 1 / -1;
			margin-top: -0.75rem;
		}
	}
</style>
