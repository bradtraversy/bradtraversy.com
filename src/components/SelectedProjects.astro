---
import { Image } from "astro:assets";
import { HOMEPAGE_PROJECTS } from "../data/home";
---

<section class="projects section" id="projects" aria-labelledby="projects-title">
	<div class="shell">
		<div class="section__head">
			<div>
				<p class="section__kicker">Independent software</p>
				<h2 id="projects-title">Side projects with <em>real utility.</em></h2>
			</div>
			<p class="section__note">
				Developer tools, experiments, open-source projects, and products I build outside
				of the main education platforms.
			</p>
		</div>

		<div class="projects__gallery">
			{
				HOMEPAGE_PROJECTS.map((project) => (
					<a
						class="project"
						href={project.url}
						target="_blank"
						rel="noreferrer"
						aria-label={`Visit ${project.title}: ${project.summary}`}
					>
						<div class="project__media">
							<Image
								src={project.image}
								alt={project.alt}
								widths={[480, 720, 960]}
								sizes="(max-width: 640px) calc(100vw - 3rem), (max-width: 1440px) calc((100vw - 8rem) / 2), 39rem"
							/>
						</div>
						<div class="project__copy">
							<div>
								<span class="project__type">{project.type}</span>
								<h3>{project.title}</h3>
							</div>
							<span class="project__arrow" aria-hidden="true">↗</span>
							<p>{project.summary}</p>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>

<style>
	.section {
		padding-block: 8.25rem;
	}

	.projects {
		background: linear-gradient(145deg, rgba(23, 17, 10, 0.96), rgba(13, 12, 10, 0.98));
	}

	.section__head {
		display: grid;
		grid-template-columns: 1fr 1.4fr;
		align-items: end;
		gap: 5rem;
		margin-bottom: 4.375rem;
	}

	.section__kicker {
		margin: 0 0 1.5rem;
		color: var(--color-gold);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	h2 {
		max-width: 45rem;
		margin: 0;
		font-size: clamp(2.625rem, 5vw, 4.625rem);
		font-weight: 500;
		letter-spacing: -0.05em;
		line-height: 1;
	}

	h2 em {
		color: var(--color-gold-soft);
		font-style: normal;
		font-weight: inherit;
	}

	.section__note {
		max-width: 31.875rem;
		justify-self: end;
		margin: 0 0 0.25rem;
		color: var(--color-muted);
	}

	.projects__gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4.75rem 2.625rem;
	}

	.project {
		display: block;
		text-decoration: none;
	}

	.project__media {
		position: relative;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border: 1px solid var(--color-line);
		background: linear-gradient(145deg, rgba(11, 10, 8, 0.98), rgba(18, 13, 8, 0.96));
	}

	.project__media::after {
		position: absolute;
		inset: 0;
		border: 1px solid transparent;
		content: "";
		pointer-events: none;
		transition: border-color 180ms ease;
	}

	.project__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transition: transform 260ms ease;
	}

	.project__copy {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 1.5rem;
		padding-top: 1.375rem;
	}

	.project__type {
		color: var(--color-muted);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	h3 {
		margin: 0.375rem 0 0;
		font-size: clamp(1.5rem, 2vw, 2rem);
		font-weight: 500;
		letter-spacing: -0.03em;
		transition: color 180ms ease;
	}

	.project__copy p {
		max-width: 32.5rem;
		margin: -0.75rem 0 0;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.project__arrow {
		color: var(--color-gold);
		font-size: 1.25rem;
		transition: transform 180ms ease;
	}

	.project:hover .project__media::after {
		border-color: var(--color-gold);
	}

	.project:hover .project__media :global(img) {
		transform: scale(1.015);
	}

	.project:hover h3 {
		color: var(--color-gold-soft);
	}

	.project:hover .project__arrow {
		transform: translate(0.1875rem, -0.1875rem);
	}

	@media (max-width: 56.25rem) {
		.section__head {
			grid-template-columns: 1fr;
			gap: 2.5rem;
		}

		.section__note {
			justify-self: start;
		}
	}

	@media (max-width: 40rem) {
		.section {
			padding-block: 5.5rem;
		}

		.section__head {
			margin-bottom: 3rem;
		}

		.projects__gallery {
			grid-template-columns: 1fr;
			gap: 3.75rem;
		}

		.project__copy {
			grid-template-columns: 1fr 1.5rem;
		}

		.project__copy p {
			grid-column: 1 / -1;
			margin-top: -0.75rem;
		}
	}
</style>
