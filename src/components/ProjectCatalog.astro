---
import { Image } from "astro:assets";
import { getProjectPrimaryHref, type ProjectEntry } from "../lib/projects";
import ProjectBadges from "./ProjectBadges.astro";
import ProjectIcon from "./ProjectIcon.astro";
import TechnologyStack from "./TechnologyStack.astro";

interface Props {
	projects: ProjectEntry[];
}

const { projects } = Astro.props;
---

<section class="project-catalog" aria-labelledby="project-catalog-title">
	<div class="shell">
		<div class="project-catalog__heading">
			<div>
				<p class="project-catalog__kicker">More projects</p>
				<h2 id="project-catalog-title">Focused tools with <em>room to grow.</em></h2>
			</div>
			<p class="project-catalog__note">
				Some are products, some are focused tools, and some began as a fix for a very
				specific problem.
			</p>
		</div>

		<div class="project-catalog__grid">
			{
				projects.map((project) => {
					const { data } = project;
					const primaryHref = getProjectPrimaryHref(project);

					return (
						<article class="project-card">
							<a
								class="project-card__media"
								href={primaryHref}
								data-image-fit={data.hero.fit}
								aria-label={`View ${data.title} project`}
							>
								<Image
									src={data.hero.src}
									alt={data.hero.alt}
									widths={[480, 720, 960]}
									sizes="(max-width: 900px) calc(100vw - 3rem), 48vw"
								/>
							</a>

							<div class="project-card__heading">
								<div class="project-card__title">
									<span class="project-card__icon">
										<ProjectIcon icon={data.icon} />
									</span>
									<h3>{data.title}</h3>
								</div>
								<ProjectBadges project={project} />
							</div>

							<p class="project-card__copy">{data.summary}</p>

							<TechnologyStack
								technologies={data.stack}
								label={`${data.title} technology stack`}
							/>

							<div class="project-card__links">
								<a href={data.liveUrl} target="_blank" rel="noreferrer">
									Visit site <span aria-hidden="true">↗</span>
								</a>
								<a href={primaryHref}>
									View project <span aria-hidden="true">→</span>
								</a>
								<a href={data.devlogUrl} target="_blank" rel="noreferrer">
									More info <span aria-hidden="true">→</span>
								</a>
								{
									data.repoUrl && (
										<a href={data.repoUrl} target="_blank" rel="noreferrer">
											{data.repoLabel ?? "Source"} <span aria-hidden="true">↗</span>
										</a>
									)
								}
							</div>
						</article>
					);
				})
			}
		</div>
	</div>
</section>

<style>
	.project-catalog {
		padding-block: 7.75rem;
		background: linear-gradient(145deg, rgba(23, 17, 10, 0.78), rgba(10, 9, 8, 0.92));
	}

	.project-catalog__heading {
		display: grid;
		grid-template-columns: 1fr 0.75fr;
		align-items: end;
		gap: 4.5rem;
		margin-bottom: 4.25rem;
	}

	.project-catalog__kicker {
		margin: 0 0 1.5rem;
		color: var(--color-gold);
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.2em;
		text-transform: uppercase;
	}

	.project-catalog__heading h2 {
		max-width: 47.5rem;
		margin: 0;
		font-size: clamp(2.75rem, 5.7vw, 4.875rem);
		font-weight: 500;
		letter-spacing: -0.055em;
		line-height: 0.98;
	}

	.project-catalog__heading h2 em {
		color: var(--color-gold-soft);
		font-style: normal;
		font-weight: inherit;
	}

	.project-catalog__note {
		max-width: 30rem;
		justify-self: end;
		margin: 0 0 0.3125rem;
		color: var(--color-muted);
	}

	.project-catalog__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 4.5rem 2.375rem;
	}

	.project-card {
		min-width: 0;
	}

	.project-card__media {
		position: relative;
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		margin-bottom: 1.75rem;
		border: 1px solid var(--color-line);
		background: var(--color-black-soft);
	}

	.project-card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
		transition: transform 260ms ease;
	}

	.project-card__media[data-image-fit="contain"] :global(img) {
		object-fit: contain;
	}

	.project-card:hover .project-card__media :global(img),
	.project-card:focus-within .project-card__media :global(img) {
		transform: scale(1.018);
	}

	.project-card__heading {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1.5rem;
		margin-bottom: 0.875rem;
	}

	.project-card__title {
		display: flex;
		align-items: center;
		gap: 0.875rem;
	}

	.project-card__icon {
		display: grid;
		width: 2.375rem;
		height: 2.375rem;
		flex: none;
		place-items: center;
		border: 1px solid var(--color-line);
		color: var(--color-gold-soft);
	}

	h3 {
		margin: 0;
		font-size: clamp(1.6875rem, 2.7vw, 2.4375rem);
		font-weight: 500;
		letter-spacing: -0.045em;
	}

	.project-card__copy {
		max-width: 36.875rem;
		margin: 0 0 1.25rem;
		color: var(--color-muted);
		font-size: 0.875rem;
	}

	.project-card :global(.technology-stack) {
		margin-bottom: 1.5rem;
	}

	.project-card__links {
		display: flex;
		flex-wrap: wrap;
		gap: 1.375rem;
		font-size: 0.75rem;
		font-weight: 700;
	}

	.project-card__links a {
		text-decoration: none;
	}

	.project-card__links a:hover,
	.project-card__links a:focus-visible {
		color: var(--color-gold-soft);
	}

	@media (max-width: 65.625rem) {
		.project-catalog__heading {
			grid-template-columns: 1fr;
			gap: 2.375rem;
		}

		.project-catalog__note {
			max-width: 41.25rem;
			justify-self: start;
		}
	}

	@media (max-width: 56.25rem) {
		.project-catalog__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 40rem) {
		.project-catalog {
			padding-block: 5.375rem;
		}

		.project-card__heading {
			flex-direction: column;
		}

		.project-catalog__heading {
			margin-bottom: 3rem;
		}

		.project-catalog__grid {
			gap: 3.625rem;
		}
	}
</style>
