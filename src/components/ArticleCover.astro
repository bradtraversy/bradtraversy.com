---
import { Image } from "astro:assets";
import type { InternalWritingEntry } from "../lib/writing";

interface Props {
	entry: InternalWritingEntry;
}

const { entry } = Astro.props;
const { hero } = entry.data.article;
---

<figure class="article-cover shell">
	<div class="article-cover__frame">
		<Image
			src={hero.src}
			alt={hero.alt}
			widths={[640, 980, 1440, 1960]}
			sizes="(max-width: 63.75rem) calc(100vw - 2.5rem), 61.25rem"
			loading="eager"
			decoding="async"
		/>
	</div>
	<figcaption>
		<strong>{hero.label}</strong>
		<span>{hero.caption}</span>
	</figcaption>
</figure>

<style>
	.article-cover {
		width: min(calc(100% - 2.5rem), 61.25rem);
		margin-block: 0;
	}

	.article-cover__frame {
		overflow: hidden;
		aspect-ratio: 16 / 9;
		border: 1px solid var(--color-line);
		background: var(--color-black-soft);
	}

	.article-cover__frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center top;
	}

	figcaption {
		display: flex;
		justify-content: space-between;
		gap: 1.5rem;
		padding-top: 0.75rem;
		color: var(--color-muted);
		font-size: 0.6875rem;
	}

	figcaption strong {
		color: var(--color-bone);
		font-weight: 600;
	}

	@media (max-width: 47.5rem) {
		.article-cover__frame {
			aspect-ratio: 16 / 10;
		}

		figcaption {
			flex-direction: column;
			gap: 0.125rem;
		}
	}
</style>
