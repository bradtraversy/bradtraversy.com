---
import AboutSection from "../components/AboutSection.astro";
import ContactCta from "../components/ContactCta.astro";
import EducationPlatforms from "../components/EducationPlatforms.astro";
import FeaturedWriting from "../components/FeaturedWriting.astro";
import HomeHero from "../components/HomeHero.astro";
import HomeProof from "../components/HomeProof.astro";
import SelectedProjects from "../components/SelectedProjects.astro";
import SocialConnections from "../components/SocialConnections.astro";
import { SITE_CONFIG } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title={SITE_CONFIG.name} description={SITE_CONFIG.description}>
	<main>
		<HomeHero />
		<HomeProof />
		<EducationPlatforms />
		<SelectedProjects />
		<FeaturedWriting />
		<AboutSection />
		<SocialConnections />
		<ContactCta />
	</main>
</BaseLayout>
